# ==============================================================================
# TEMPLATE DE VARIÁVEIS DE AMBIENTE - SQUAD A (FICR)
# Copie este arquivo para ".env" e preencha sua chave do Google Gemini:
#   cp .env.example .env
# ==============================================================================

# Porta do servidor HTTP local / hospedagem (padrão local: 3000)
PORT=3000

# Ambiente de execução (development | production)
NODE_ENV=production

# Chave de API do Google Gemini (Obrigatório para o servidor responder às requisições do chat)
# Crie sua chave gratuita no Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=sua_chave_gemini_aqui

# Modelo da IA do Google Gemini (Versão ativa: gemini-3.6-flash)
GEMINI_MODEL=gemini-3.6-flash
