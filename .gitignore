# ==============================================================================
# .gitignore - Squad A ("OS Debs" - FICR)
# Proteção de credenciais, ambiente e arquivos gerados
# ==============================================================================

# Arquivos de ambiente e segredos (NUNCA ENVIAR PARA O GITHUB)
.env
.env.local
.env.*.local
*.env

# Dependências do Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Arquivos temporários e logs de sistema
*.log
.DS_Store
Thumbs.db
desktop.ini

# Diretórios de build/deploy locais
dist/
build/
.cache/
